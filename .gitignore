!data/README.md

# Model and index artifacts
artifacts/
indexes/
*.faiss
*.npz
*.joblib
*.pkl
*.pt
*.onnx

# Experiment outputs - regenerate with `make experiment`; the committed record
# of the measured results is docs/results.md
outputs/
runs/
mlruns/
reports/*
!reports/.gitkeep

# Notebooks
.ipynb_checkpoints/

# Databases
*.db
*.sqlite
*.sqlite3
!tests/**/*.sqlite3

# Logs
logs/
*.log

# Editors and OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
