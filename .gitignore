.ruff_cache/
.dmypy.json
dmypy.json

# Secrets and local configuration
.env
.env.local
.env.*.local
*.pem
*.key
!.env.example

# Data directories - never commit corpora or derived indexes
data/raw/
data/interim/
data/processed/
data/external/
data/cache/
