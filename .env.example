# Copy to .env and fill in local values. Never commit .env.

# --- Service ---
RAG_ENV=development
RAG_LOG_LEVEL=INFO
RAG_API_HOST=0.0.0.0
RAG_API_PORT=8000

# --- Relational storage ---
# SQLite is the zero-dependency default used by tests and the local demo.
# Point this at PostgreSQL for the full deployment.
RAG_DATABASE_URL=sqlite:///data/processed/rag_platform.sqlite3
# RAG_DATABASE_URL=postgresql+psycopg://rag:CHANGE_ME@localhost:5432/rag_platform

# --- Vector storage ---
# Supported backends: numpy (in-process), pgvector, qdrant
RAG_VECTOR_BACKEND=numpy
RAG_QDRANT_URL=http://localhost:6333
RAG_QDRANT_COLLECTION=rag_chunks

# --- Cache ---
RAG_REDIS_URL=redis://localhost:6379/0
RAG_CACHE_ENABLED=false

# --- Embeddings ---
# Backends: tfidf_svd (local, no network), sentence_transformers, openai
RAG_EMBEDDING_BACKEND=tfidf_svd
RAG_EMBEDDING_DIM=256
RAG_SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Answer generation ---
# Backends: extractive (no external service), anthropic, openai
RAG_GENERATION_BACKEND=extractive

# --- External data sources ---
# SEC EDGAR requires a descriptive User-Agent containing a contact address.
# See https://www.sec.gov/os/webmaster-faq#developers
RAG_SEC_USER_AGENT=your-name your-email@example.com
RAG_NCBI_TOOL_NAME=enterprise-rag-platform
RAG_NCBI_EMAIL=your-email@example.com

# --- Credentials (leave blank unless the matching backend is selected) ---
RAG_OPENAI_API_KEY=
RAG_ANTHROPIC_API_KEY=
RAG_NCBI_API_KEY=
